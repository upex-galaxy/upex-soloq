        {
          "name": "Integration - POST payment for sent/overdue invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "{{auth_cookie_name}}={{sb_auth_cookie}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount_received\": 150.0,\n  \"payment_method\": \"bank_transfer\",\n  \"payment_date\": \"{{payment_date}}\",\n  \"notes\": \"QA retest SQ-52\",\n  \"reference\": \"SQ52-{{run_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/invoices/{{qa_invoice_id_sent}}/payments",
              "host": ["{{base_url}}"],
              "path": ["api", "invoices", "{{qa_invoice_id_sent}}", "payments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json().data || {};",
                  "pm.collectionVariables.set('last_payment_id', data.id || '');"
                ]
              }
            }
          ]
        },
