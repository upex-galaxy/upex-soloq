{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "supabase": {
      "type": "local",
      "command": ["npx", "-y", "@supabase/mcp-server-supabase@latest"],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "${sbp_baa4bc048fd96b181fbc3b5152413b19824319b0}"
      },
      "enabled": true
    },
    "tavily": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.tavily.com/mcp/?tavilyApiKey=${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}"
      ]
    },
    "atlassian": {
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://millananayamiguel.atlassian.net",
        "JIRA_USERNAME": "millananayamiguel@gmail.com",
        "JIRA_API_TOKEN": "${env:JIRA_API_TOKEN}"
      }
    }
  }
}
