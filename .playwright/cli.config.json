{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "headless": false
    },
    "contextOptions": {
      "viewport": {
        "width": 420,
        "height": 874
      }
    }
  },
  "outputDir": ".context/PBI/testing-session",
  "outputMode": "file",
  "console": {
    "level": "warning"
  },
  "testIdAttribute": "data-testid",
  "timeouts": {
    "action": 10000,
    "navigation": 30000
  }
}
