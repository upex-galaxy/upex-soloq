      "name": "SQ-48 Filter by status",
      "description": "Escenarios de filtro por estado, no-results y auth.",
      "item": [
        {
          "name": "Happy - GET invoices all",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "{{auth_cookie_name}}={{sb_auth_cookie}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/invoices?page=1&limit=20&sortBy=created_at&sortOrder=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "invoices"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "sortBy",
                  "value": "created_at"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Has data and pagination', function () {",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body).to.have.property('pagination');",
                  "});"
                ]
              }
            }
          ]
        },
